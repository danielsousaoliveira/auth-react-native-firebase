# Firebase configuration
#
# This project uses @react-native-firebase, which is configured natively via
# google-services.json (Android) and GoogleService-Info.plist (iOS) rather than
# a JS config object. Download these files from your Firebase project console
# (Project settings > General > Your apps) and place them at the project root
# (paths referenced in app.json under expo.android.googleServicesFile and
# expo.ios.googleServicesFile). Do NOT commit these files - they are gitignored.
#
# The values below mirror the keys found in those files / the Firebase web
# config snippet. They are provided for documentation and for any tooling or
# scripts that need the values as environment variables. Copy this file to
# .env and fill in your own project's values - never commit real secrets.

FIREBASE_API_KEY=your-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-app-id

# Bundle identifiers configured in app.json (must match your Firebase apps)
IOS_BUNDLE_IDENTIFIER=com.apptest
ANDROID_PACKAGE=com.apptest
